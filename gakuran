MiscTab:AddSection("Wang Lin Portal Step (True FE Replicated)")

local isWarpActive = false
local maxMouseDistance = 300
local warpCooldown = 0.5
local lastWarpTime = 0

local LocalPlayer = game:GetService("Players").LocalPlayer
local Mouse = LocalPlayer:GetMouse()
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

-- ฟังก์ชันสร้าง Particle บน Accessory/Tool ของตัวละครเพื่อให้ Replicate ไปหาคนอื่น (FE 100%)
local function createFEReplicatedEffect(char)
    if not char then return end

    -- ค้นหาส่วนที่จะใช้เกาะ Effect (เรียงลำดับ: Tool Handle -> Hat/Accessory -> Torso)
    local targetPart = nil
    local tool = char:FindFirstChildOfClass("Tool")
    if tool and tool:FindFirstChild("Handle") then
        targetPart = tool.Handle
    else
        for _, child in ipairs(char:GetChildren()) do
            if child:IsA("Accessory") and child:FindFirstChild("Handle") then
                targetPart = child.Handle
                break
            end
        end
    end

    if not targetPart then
        targetPart = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    end

    if targetPart then
        task.spawn(function()
            -- 1. สร้าง ParticleEmitter เกาะ Object บนตัวละคร
            local pe = Instance.new("ParticleEmitter")
            pe.Name = "FE_WangLin_Particle"
            pe.Texture = "rbxassetid://243660364"
            pe.Color = ColorSequence.new(Color3.fromRGB(180, 50, 255))
            pe.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 6), NumberSequenceKeypoint.new(1, 0)})
            pe.Lifetime = NumberRange.new(0.4, 0.8)
            pe.Rate = 100
            pe.Speed = NumberRange.new(5, 12)
            pe.Parent = targetPart

            -- 2. สร้าง Highlight เรืองแสงสีม่วงบนตัวละคร
            local hl = Instance.new("Highlight")
            hl.Name = "FE_WangLin_Highlight"
            hl.FillColor = Color3.fromRGB(130, 0, 255)
            hl.OutlineColor = Color3.fromRGB(220, 100, 255)
            hl.FillTransparency = 0.1
            hl.OutlineTransparency = 0
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Parent = char

            -- 3. เล่น Sound Effect ที่กระจายให้คนรอบข้างได้ยิน
            local sound = Instance.new("Sound")
            sound.SoundId = "rbxassetid://2814442547"
            sound.Volume = 3
            sound.Parent = targetPart
            sound:Play()

            -- หน่วงเวลา 0.5 วินาทีแล้วเคลียร์ Effect ออก
            task.wait(0.5)
            pe.Enabled = false
            TweenService:Create(hl, TweenInfo.new(0.3), {FillTransparency = 1, OutlineTransparency = 1}):Play()
            
            task.wait(0.5)
            pe:Destroy()
            hl:Destroy()
            sound:Destroy()
        end)
    end
end

-- ฟังก์ชันสร้างประตูมิติทรงตั้งตรง 90 องศา (Client Side Visual)
local function spawnVerticalVoidPortal(position)
    task.spawn(function()
        local portal = Instance.new("Part")
        portal.Name = "WangLinPortal"
        portal.Size = Vector3.new(0.2, 1, 1)
        
        -- บังคับ CFrame ให้ประตูมิติตั้งตรง 90 องศา
        portal.CFrame = CFrame.new(position) * CFrame.Angles(math.rad(90), 0, 0)
        
        portal.Anchored = true
        portal.CanCollide = false
        portal.Material = Enum.Material.Neon
        portal.Color = Color3.fromRGB(130, 0, 255)
        portal.Shape = Enum.PartType.Cylinder
        portal.Parent = workspace

        local ring = Instance.new("SelectionBox")
        ring.Adornee = portal
        ring.Color3 = Color3.fromRGB(220, 100, 255)
        ring.LineThickness = 0.25
        ring.Parent = portal

        local particle = Instance.new("ParticleEmitter")
        particle.Texture = "rbxassetid://243660364"
        particle.Color = ColorSequence.new(Color3.fromRGB(180, 50, 255))
        particle.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 5), NumberSequenceKeypoint.new(1, 0)})
        particle.Lifetime = NumberRange.new(0.3, 0.7)
        particle.Rate = 60
        particle.Speed = NumberRange.new(3, 6)
        particle.Parent = portal

        local openTween = TweenService:Create(portal, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = Vector3.new(0.2, 12, 12)
        })
        openTween:Play()

        local spinConnection
        spinConnection = RunService.RenderStepped:Connect(function()
            if portal and portal.Parent then
                portal.CFrame = portal.CFrame * CFrame.Angles(0, 0.08, 0)
            else
                spinConnection:Disconnect()
            end
        end)

        task.wait(0.5)

        local closeTween = TweenService:Create(portal, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Size = Vector3.new(0.2, 0, 0)
        })
        closeTween:Play()

        closeTween.Completed:Connect(function()
            spinConnection:Disconnect()
            portal:Destroy()
        end)
    end)
end

local function preventRagdoll(humanoid, hrp)
    if not humanoid or not hrp then return end
    humanoid.PlatformStand = false
    humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
    humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
end

local function performPortalWarp()
    if tick() - lastWarpTime < warpCooldown then return end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")

    if hrp and humanoid and humanoid.Health > 0 then
        lastWarpTime = tick()

        local startPos = hrp.Position
        local targetPos = Mouse.Hit.Position

        local distance = (targetPos - startPos).Magnitude
        if distance > maxMouseDistance then
            local direction = (targetPos - startPos).Unit
            targetPos = startPos + (direction * maxMouseDistance)
        end

        local endCFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0), targetPos + hrp.CFrame.LookVector)

        -- 1. เล่นเอฟเฟกต์ที่ Replicate ข้ามเซิร์ฟเวอร์ (คนอื่นเห็น Particle + Highlight + เสียงวาร์ป)
        createFEReplicatedEffect(char)

        -- 2. สร้างวงแหวนประตูมิติแบบตั้งตรง ณ ต้นทางและปลายทาง
        spawnVerticalVoidPortal(startPos)
        spawnVerticalVoidPortal(targetPos + Vector3.new(0, 3, 0))

        -- 3. ทำการย้ายตำแหน่ง
        preventRagdoll(humanoid, hrp)
        hrp.CFrame = endCFrame
        preventRagdoll(humanoid, hrp)
    end
end

MiscTab:AddToggle("Enable Wang Lin Portal Step", false, function(Value)
    isWarpActive = Value
end)

MiscTab:AddSlider("Max Portal Distance", 50, 1000, 300, function(Value)
    maxMouseDistance = Value
end)

local warpKeyConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if not isWarpActive then return end

    if input.KeyCode == Enum.KeyCode.Q then
        performPortalWarp()
    end
end)

if getgenv().ScriptConnections then
    table.insert(getgenv().ScriptConnections, warpKeyConn)
end
