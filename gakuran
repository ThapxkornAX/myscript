local function getPlayerList()
    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            table.insert(list, plr.Name)
        end
    end
    if #list == 0 then table.insert(list, "No Players") end
    return list
end

local function addSearchableDropdown(tab, title, callback)
    local selected = "Select Player..."
    local options = getPlayerList()

    tab:AddSection(title)

    local boxText = ""
    tab:AddTextBox("🔍 Search " .. title, "พิมพ์ชื่อเพื่อกรอง...", function(txt)
        boxText = txt
    end)

    local dropdown = tab:AddDropdown(title, options, function(opt)
        selected = opt
        if callback then callback(selected) end
    end)

    task.spawn(function()
        local lastSearch = ""
        while task.wait(0.5) do
            if lastSearch ~= boxText then
                lastSearch = boxText
                local filtered = {}
                local fullList = getPlayerList()
                
                if boxText == "" then
                    filtered = fullList
                else
                    for _, name in ipairs(fullList) do
                        if string.find(name:lower(), boxText:lower()) then
                            table.insert(filtered, name)
                        end
                    end
                    if #filtered == 0 then table.insert(filtered, "No Results") end
                end

                if dropdown and typeof(dropdown.Refresh) == "function" then
                    dropdown:Refresh(filtered, true)
                end
            end
        end
    end)

    return function() return selected end
end

