local MiscTab = Library:AddTab("Misc", "⚙️")

MiscTab:AddSection("Player Modifications")

local speedMultiplier = 1
local customJumpHeight = 50
local isNoclipActive = false

-- ระบบ CFrame Speed Hack & NoClip Loop
RunService.Stepped:Connect(function()
    local char = LocalPlayer.Character
    if isNoclipActive and char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end)

RunService.RenderStepped:Connect(function(deltaTime)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    
    if hrp and humanoid and humanoid.MoveDirection.Magnitude > 0 then
        if speedMultiplier > 1 then
            local moveVector = humanoid.MoveDirection * ((speedMultiplier * 10) * deltaTime)
            hrp.CFrame = hrp.CFrame + moveVector
        end
    end

    if humanoid then
        if customJumpHeight > 50 then
            humanoid.UseJumpPower = true
            humanoid.JumpPower = customJumpHeight
            humanoid.JumpHeight = customJumpHeight / 3
        end
    end
end)

MiscTab:AddToggle("Enable NoClip", false, function(Value)
    isNoclipActive = Value
end)

MiscTab:AddSlider("WalkSpeed", 16, 250, 16, function(Value)
    speedMultiplier = Value / 16
end)

MiscTab:AddSlider("JumpPower", 50, 300, 50, function(Value)
    customJumpHeight = Value
end)

