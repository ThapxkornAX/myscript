            local humanoid = char and char:FindFirstChildOfClass("Humanoid")

            if hrp and humanoid and humanoid.Health > 0 then
                local distance = (myHrp.Position - hrp.Position).Magnitude

                if distance <= maxDistance then
                    activePlayers[plr.Name] = true
                    createHealthGui(char, plr.Name, plr)

                    local gui = healthGuis[plr.Name]
                    if gui and gui:FindFirstChild("Frame") then
                        local hpPercent = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
                        local rpName = getRPName and getRPName(plr) or plr.DisplayName

                        local hpText = gui.Frame:FindFirstChild("HPText")
                        local fillBar = gui.Frame:FindFirstChild("BgBar") and gui.Frame.BgBar:FindFirstChild("Fill")

                        if hpText then
                            hpText.Text = rpName .. "\n[" .. math.floor(humanoid.Health) .. "/" .. math.floor(humanoid.MaxHealth) .. "]"
                        end

                        if fillBar then
                            fillBar.Size = UDim2.new(hpPercent, 0, 1, 0)
                            fillBar.BackgroundColor3 = Color3.fromHSV(hpPercent * 0.3, 0.9, 0.9)
                        end
                    end
                end
            end
        end
    end

    for plrName, gui in pairs(healthGuis) do
        if not activePlayers[plrName] then
            removeHealthGui(plrName)
        end
    end
end)

