        end
    end
end)

MiscTab:AddSlider("Pose Frame (เลือกเฟรมท่า)", 0, 100, 50, function(Value)
    freezeTime = Value / 100
    if activeTrack and activeTrack.Length > 0 then
        activeTrack.TimePosition = activeTrack.Length * freezeTime
    end
end)

function playReplicatedAnim()
    local myChar = LocalPlayer.Character
    local humanoid = myChar and myChar:FindFirstChildOfClass("Humanoid")
    
    if humanoid and currentAnimId ~= "" then
        if activeTrack then activeTrack:Stop() end
        
        local anim = Instance.new("Animation")
        anim.AnimationId = currentAnimId
        
        local animator = humanoid:FindFirstChildOfClass("Animator") or humanoid
        activeTrack = animator:LoadAnimation(anim)
        activeTrack.Priority = Enum.AnimationPriority.Action4
        activeTrack:Play()
        
        if isFreezeMode then
            task.wait(0.05)
            if activeTrack.Length > 0 then
                activeTrack.TimePosition = activeTrack.Length * freezeTime
            end
            activeTrack:AdjustSpeed(0)
        end
    end
end

