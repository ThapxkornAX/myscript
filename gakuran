local function updateCardData(plr)
    local card = playerCards[plr.Name] or createCard(plr)
    
    local targetFolder = workspace:FindFirstChild("Players") and workspace.Players:FindFirstChild(plr.Name)
    local targetData = targetFolder and targetFolder:FindFirstChild("PlayerData")

    if targetData then
        local pFirstName = getValue(targetData, "FirstName")
        local pLastName = getValue(targetData, "LastName")
        local fullName = (pFirstName ~= "N/A" or pLastName ~= "N/A") and (pFirstName .. " " .. pLastName) or "N/A"
        
        local pGender = getValue(targetData, "Gender")
        local pAge = getValue(targetData, "Age")
        local pEth = getValue(targetData, "Ethnicity")
        local pCombat = getValue(targetData, "CombatStyle")
        local pHeight = getValue(targetData, "Height")
        if pHeight == "N/A" then pHeight = getValue(targetData, "CurrentHeight") end

        card.NameLabel.Text = "RP Name: " .. fullName
        card.StatsLabel.Text = "Gender: " .. pGender .. " | Age: " .. pAge .. " | Eth: " .. pEth .. " | H: " .. pHeight
        card.CombatLabel.Text = "Combat: " .. pCombat
    else
        card.NameLabel.Text = "RP Name: Loading..."
        card.StatsLabel.Text = "Fetching PlayerData..."
        card.CombatLabel.Text = "Combat: N/A"
    end
end

task.spawn(function()
