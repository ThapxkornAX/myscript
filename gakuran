local isFlyBehindActive = false
local flyBehindDistance = 3.5

local getFlyBehindTarget = addSearchableDropdown(MiscTab, "Fly Behind Target", function(target) end)

MiscTab:AddToggle("Enable Fly Behind", false, function(Value)
    isFlyBehindActive = Value
end)

MiscTab:AddSlider("Behind Distance", 1, 20, 3.5, function(Value)
    flyBehindDistance = Value
end)

RunService.Heartbeat:Connect(function()
    if not isFlyBehindActive then return end
    local targetName = getFlyBehindTarget()
    if not targetName or targetName == "" or targetName == "No Players" or targetName == "No Results" or targetName == "Select Player..." then return end

    local targetPlr = Players:FindFirstChild(targetName)
    local targetChar = targetPlr and targetPlr.Character
    local targetHrp = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
    
    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    
    if targetHrp and myHrp then
        myHrp.CFrame = targetHrp.CFrame * CFrame.new(0, 1.5, flyBehindDistance)
        myHrp.AssemblyLinearVelocity = Vector3.zero
        myHrp.AssemblyAngularVelocity = Vector3.zero
    end
end)

-- ==========================================
-- FLY ATTACHED
-- ==========================================
local isFlyAttachedActive = false
local attachOffset = CFrame.new(0, 0, 0)

local getFlyAttachTarget = addSearchableDropdown(MiscTab, "Fly Attached Target", function(target) end)

MiscTab:AddDropdown("Attach Position", {"Center", "Right", "Left", "Front", "Top"}, function(Option)
    if Option == "Center" then attachOffset = CFrame.new(0, 0, 0)
    elseif Option == "Right" then attachOffset = CFrame.new(2.5, 0, 0)
    elseif Option == "Left" then attachOffset = CFrame.new(-2.5, 0, 0)
    elseif Option == "Front" then attachOffset = CFrame.new(0, 0, -2.5)
    elseif Option == "Top" then attachOffset = CFrame.new(0, 3.5, 0)
    end
end)

MiscTab:AddToggle("Enable Fly Attached", false, function(Value)
    isFlyAttachedActive = Value
end)

RunService.Heartbeat:Connect(function()
    if not isFlyAttachedActive then return end
    local targetName = getFlyAttachTarget()
    if not targetName or targetName == "" or targetName == "No Players" or targetName == "No Results" or targetName == "Select Player..." then return end

    local targetPlr = Players:FindFirstChild(targetName)
    local targetChar = targetPlr and targetPlr.Character
    local targetHrp = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
    
    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    
    if targetHrp and myHrp then
        myHrp.CFrame = targetHrp.CFrame * attachOffset
        myHrp.AssemblyLinearVelocity = Vector3.zero
        myHrp.AssemblyAngularVelocity = Vector3.zero
    end
end)

