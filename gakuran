local function scanGameAnimations()
    local animList = {}
    
    local myChar = LocalPlayer.Character
    if myChar then
        for _, desc in ipairs(myChar:GetDescendants()) do
            if desc:IsA("Animation") and desc.AnimationId ~= "" then
                animList[desc.Name .. " (" .. desc.Parent.Name .. ")"] = desc.AnimationId
            end
        end
    end
    
    for _, desc in ipairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
        if desc:IsA("Animation") and desc.AnimationId ~= "" then
            animList[desc.Name] = desc.AnimationId
        end
    end
    
    return animList
end

local availableAnims = scanGameAnimations()
local dropdownOptions = {}
for name, _ in pairs(availableAnims) do table.insert(dropdownOptions, name) end
if #dropdownOptions == 0 then table.insert(dropdownOptions, "No Anims Found - Click Refresh") end

local animDropdown = MiscTab:AddDropdown("Select Game Anim", dropdownOptions, function(Option)
