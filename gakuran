-- ฟังก์ชันดึงค่าจาก Value / Attributes
local function getValue(parent, name)
    if not parent then return "N/A" end
    local child = parent:FindFirstChild(name)
    if child and (child:IsA("ValueBase") or child:IsA("StringValue") or child:IsA("IntValue") or child:IsA("NumberValue")) then
        return tostring(child.Value)
    elseif parent:GetAttribute(name) ~= nil then
        return tostring(parent:GetAttribute(name))
    end
    return "N/A"
end

