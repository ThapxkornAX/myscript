MiscTab:AddSlider("ESP Distance", 30, 300, 100, function(Value)
    maxDistance = Value
end)

RunService.RenderStepped:Connect(function()
    if not isHealthEspActive then return end

    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return end

    local activePlayers = {}

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local char = plr.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local humanoid = char and char:FindFirstChildOfClass("Humanoid")

            if hrp and humanoid and humanoid.Health > 0 then
                local distance = (myHrp.Position - hrp.Position).Magnitude

                if distance <= maxDistance then
                    activePlayers[plr.Name] = true
                    createHealthGui(char, plr.Name)

                    local gui = healthGuis[plr.Name]
                    if gui and gui:FindFirstChild("Frame") then
                        local hpPercent = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
                        local rpName = getRPName(plr)

                        local hpText = gui.Frame:FindFirstChild("HPText")
                        local fillBar = gui.Frame.Frame:FindFirstChild("Fill")

                        if hpText then
                            hpText.Text = rpName .. " [" .. math.floor(humanoid.Health) .. "/" .. math.floor(humanoid.MaxHealth) .. "]"
                        end

                        if fillBar then
                            fillBar.Size = UDim2.new(hpPercent, 0, 1, 0)
                            fillBar.BackgroundColor3 = Color3.fromHSV(hpPercent * 0.3, 0.9, 0.9)
                        end
                    end
                end
            end
        end
    end

    for plrName, gui in pairs(healthGuis) do
        if not activePlayers[plrName] then
            removeHealthGui(plrName)
        end
    end
end)
