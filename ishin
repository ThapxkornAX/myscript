local isSprinting = false
local function setSprintState(enable)
    if enable and not isSprinting then
        isSprinting = true
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.LeftShift, false, game)
        if hum then hum.WalkSpeed = FarmConfig.SprintSpeed end
    elseif not enable and isSprinting then
        isSprinting = false
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.LeftShift, false, game)
        if hum then hum.WalkSpeed = 16 end
    end
end

local isParrying = false
local lastParryTime = 0
local processedTracks = setmetatable({}, { __mode = "k" })
local activeCriticalChars = {}

local function executeSingleParry()
    local now = tick()
    if isParrying or (now - lastParryTime) < ParryConfig.Cooldown then return end
    isParrying = true
    lastParryTime = now

    task.spawn(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
        task.wait(0.04)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
        isParrying = false
    end)
end

local function getAngleThreshold()
    if ParryConfig.Angle == 360 then
        return -1.0
    elseif ParryConfig.Angle == 180 then
        return -0.25
    elseif ParryConfig.Angle == 90 then
        return 0.707
    end
    return -0.25
end

local function isEnemyTargetingMe(enemyChar)
    if not root or not hum or hum.Health <= 0 then return false end
    local eRoot = enemyChar:FindFirstChild("HumanoidRootPart")
    if not eRoot then return false end

    local myPos = root.Position
    local ePos = eRoot.Position

    if math.abs(myPos.Y - ePos.Y) > 6 then return false end

    local horizontalDiff = Vector2.new(ePos.X - myPos.X, ePos.Z - myPos.Z)
    local dist2D = horizontalDiff.Magnitude

    if dist2D <= ParryConfig.Distance then
        if ParryConfig.Angle == 360 then
            return true
        end

        local myForward = root.CFrame.LookVector
        local myForward2D = Vector2.new(myForward.X, myForward.Z).Unit
        local dirToEnemy2D = horizontalDiff.Unit

        return myForward2D:Dot(dirToEnemy2D) >= getAngleThreshold()
    end
    return false
end

local function getCriticalDelayForCharacter(enemyChar)
    local eHum = enemyChar:FindFirstChildOfClass("Humanoid")
    local eAnimator = eHum and eHum:FindFirstChildOfClass("Animator")
    if eAnimator then
        for _, track in ipairs(eAnimator:GetPlayingAnimationTracks()) do
            local tName = string.lower(track.Name)
            for styleKey, delayVal in pairs(CriticalStyleTimings) do
                if tName:find(styleKey) then
                    return delayVal
                end
            end
        end
    end
    return ParryConfig.DefaultCriticalDelay
end

local function handleCriticalAdded(enemyChar, child)
    if child.Name == "_H_Critical" or child.Name:find("Critical") then
        if activeCriticalChars[enemyChar] then return end
        activeCriticalChars[enemyChar] = true

        local targetDelay = getCriticalDelayForCharacter(enemyChar)

        task.delay(targetDelay, function()
            if not ParryConfig.Enabled or isParrying then 
                task.delay(0.2, function() activeCriticalChars[enemyChar] = nil end)
                return 
            end

            if isEnemyTargetingMe(enemyChar) then
                executeSingleParry()
            end

            task.delay(0.25, function()
                activeCriticalChars[enemyChar] = nil
            end)
        end)
    end
end

local function getAttackData(track)
    local animObj = track.Animation
    if animObj then
        local animId = animObj.AnimationId
        local numId = animId:match("%d+")
        if numId and IdToAttackName[numId] then
            local attackName = IdToAttackName[numId]
            if CombatAttackPaths[attackName] then
                return CombatAttackPaths[attackName]
            end
        end
    end

    local trackName = track.Name
    if CombatAttackPaths[trackName] then
        return CombatAttackPaths[trackName]
    end

    local lowerName = string.lower(trackName)
    local isNonCombat = lowerName:find("idle") or lowerName:find("walk") or lowerName:find("run") 
        or lowerName:find("sprint") or lowerName:find("jump") or lowerName:find("fall") 
        or lowerName:find("land") or lowerName:find("sit") or lowerName:find("dance") 
        or lowerName:find("emote") or lowerName:find("weave") or lowerName:find("stance") 
        or lowerName:find("block") or lowerName:find("hit")

    if not isNonCombat then
        if lowerName:find("critical") or lowerName:find("heavy") or lowerName:find("crit") then
            for styleKey, timingVal in pairs(CriticalStyleTimings) do
                if lowerName:find(styleKey) then
                    return { Impact = timingVal }
                end
            end
            local dur = (track.Length > 0) and track.Length or 1.1
            return { Impact = dur * 0.50 }
        elseif lowerName:find("punch") or lowerName:find("kick") or lowerName:find("wave") 
            or lowerName:find("attack") or lowerName:find("strike") or lowerName:find("slash") 
            or lowerName:find("swing") or lowerName:find("cut") or lowerName:find("jab") 
            or lowerName:find("thrust") or lowerName:find("grab") or lowerName:find("slam") 
            or lowerName:find("tackle") or lowerName:find("kendo") or lowerName:find("sword") then
            local dur = (track.Length > 0) and track.Length or 0.8
            return { Impact = dur * 0.30 }
        end
    end

    return nil
end

local function handleAttackTrack(enemyChar, track)
    if processedTracks[track] then return end
    if activeCriticalChars[enemyChar] then return end

    local attackData = getAttackData(track)
    if not attackData then return end

    local lowerName = string.lower(track.Name)
    if lowerName:find("critical") or lowerName:find("heavy") or lowerName:find("crit") then
        activeCriticalChars[enemyChar] = true
        task.delay(0.6, function() activeCriticalChars[enemyChar] = nil end)
    end

    local speed = (track.Speed > 0) and track.Speed or 1
    local currentPos = track.TimePosition
    local impactPoint = attackData.Impact
    local triggerPoint = math.max(0, impactPoint - ParryConfig.PreImpactTime)
    local delayTime = math.max(0, (triggerPoint - currentPos) / speed)

    task.delay(delayTime, function()
        if not ParryConfig.Enabled or isParrying or not root or not hum or hum.Health <= 0 then return end
        if processedTracks[track] or not track.IsPlaying then return end

        if isEnemyTargetingMe(enemyChar) then
            processedTracks[track] = true
            executeSingleParry()
        end
    end)
end

local trackedAnimators = {}
local hookedCharacters = {}

local function setupCharacterHook(targetModel)
    if not targetModel or targetModel == char or hookedCharacters[targetModel] then return end
    hookedCharacters[targetModel] = true

    local eHum = targetModel:FindFirstChildOfClass("Humanoid")
    local eAnimator = eHum and eHum:FindFirstChildOfClass("Animator")

    if eAnimator and not trackedAnimators[eAnimator] then
        trackedAnimators[eAnimator] = true
        eAnimator.AnimationPlayed:Connect(function(track)
            handleAttackTrack(targetModel, track)
        end)
    end

    targetModel.ChildAdded:Connect(function(child)
        handleCriticalAdded(targetModel, child)
    end)

    local existingCrit = targetModel:FindFirstChild("_H_Critical")
    if existingCrit then
        handleCriticalAdded(targetModel, existingCrit)
    end
end

local function scanAllCharacters()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Humanoid") and obj.Parent and obj.Parent ~= char and obj.Parent:IsA("Model") then
            setupCharacterHook(obj.Parent)
        end
    end
end

scanAllCharacters()

Workspace.DescendantAdded:Connect(function(descendant)
    if descendant:IsA("Humanoid") and descendant.Parent and descendant.Parent ~= char and descendant.Parent:IsA("Model") then
        setupCharacterHook(descendant.Parent)
    end
end)

RunService.Heartbeat:Connect(function()
    if not ParryConfig.Enabled or isParrying or not root or not hum or hum.Health <= 0 then return end

    for anim, _ in pairs(trackedAnimators) do
        local enemyChar = anim.Parent and anim.Parent.Parent
        if enemyChar and enemyChar ~= char and enemyChar:IsA("Model") then
            if not activeCriticalChars[enemyChar] and isEnemyTargetingMe(enemyChar) then
                for _, track in ipairs(anim:GetPlayingAnimationTracks()) do
                    if not processedTracks[track] then
                        local attackData = getAttackData(track)
                        if attackData and track.Speed > 0 and track.WeightCurrent > 0.15 then
                            local timePos = track.TimePosition
                            local impactPoint = attackData.Impact
                            if timePos >= (impactPoint - ParryConfig.PreImpactTime) and timePos <= (impactPoint + 0.12) then
                                processedTracks[track] = true
                                executeSingleParry()
                                break
                            end
                        end
                    end
                end
            end
        end
    end
end)

