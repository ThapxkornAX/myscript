local VisualFolder = Workspace:FindFirstChild("PathVisualFolder") or Instance.new("Folder")
VisualFolder.Name = "PathVisualFolder"
VisualFolder.Parent = Workspace

local function clearPathVisual()
    VisualFolder:ClearAllChildren()
end

local function renderPathVisual(waypoints)
    clearPathVisual()
    if not FarmConfig.ShowPathVisual or not waypoints or #waypoints < 2 then return end

    local attachments = {}
    for i, wp in ipairs(waypoints) do
        local part = Instance.new("Part")
        part.Name = "WP_Node_" .. i
        part.Size = Vector3.new(0.5, 0.2, 0.5)
        part.Position = wp.Position
        part.Anchored = true
        part.CanCollide = false
        part.Transparency = 0.4
        part.Material = Enum.Material.Neon
        part.Color = (i == #waypoints) and Color3.fromRGB(255, 60, 60) or Color3.fromRGB(0, 170, 255)
        part.Parent = VisualFolder

        local corner = Instance.new("SpecialMesh")
        corner.MeshType = Enum.MeshType.Cylinder
        corner.Parent = part

        local att = Instance.new("Attachment")
        att.Position = Vector3.new(0, 0.1, 0)
        att.Parent = part
        table.insert(attachments, att)
    end

    for i = 1, #attachments - 1 do
        local beam = Instance.new("Beam")
        beam.Name = "PathBeam_" .. i
        beam.Attachment0 = attachments[i]
        beam.Attachment1 = attachments[i + 1]
        beam.Width0 = 0.25
        beam.Width1 = 0.25
        beam.FaceCamera = true
        beam.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 200, 255)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 255, 170))
        })
        beam.Transparency = NumberSequence.new(0.3)
        beam.LightEmission = 0.8
        beam.Parent = VisualFolder
    end
end

