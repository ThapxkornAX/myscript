local function isActionPromptVisibleOnScreen()
    for _, gui in ipairs(pgui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Enabled then
            for _, label in ipairs(gui:GetDescendants()) do
                if (label:IsA("TextLabel") or label:IsA("TextButton")) and label.Visible then
                    local txt = label.Text:upper()
                    if txt:find("CLEAN") or txt:find("[T]") or txt:find("STANCE") or txt:find("INTERACT") then
                        return true
                    end
                end
            end
        end
    end
    return false
end

local function getAccurateFloorLevel(position)
    local rayOrigin = position + Vector3.new(0, 4, 0)
    local rayDirection = Vector3.new(0, -30, 0)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = {char, VisualFolder}
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude

    local rayResult = Workspace:Raycast(rayOrigin, rayDirection, raycastParams)
    local groundY = rayResult and rayResult.Position.Y or position.Y
    local FLOOR_DIVIDER_Y = -4.5

    return (groundY >= FLOOR_DIVIDER_Y) and 2 or 1, groundY
end

local lastJumpTick = 0
local function executePreciseJump()
    local now = tick()
    if (now - lastJumpTick) >= 0.65 and hum.FloorMaterial ~= Enum.Material.Air then
        lastJumpTick = now
        hum.Jump = true
        task.defer(function()
            task.wait(0.08)
            hum.Jump = false
        end)
    end
end

local function shouldJumpObstacle(moveDirection)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = {char, VisualFolder}
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude

    local checkDir = moveDirection and Vector3.new(moveDirection.X, 0, moveDirection.Z).Unit or root.CFrame.LookVector

    local feetPos = root.Position + Vector3.new(0, -2.2, 0)
    local kneePos = root.Position + Vector3.new(0, -0.9, 0)

    local feetRay = Workspace:Raycast(feetPos, checkDir * 2.6, raycastParams)
    local kneeRay = Workspace:Raycast(kneePos, checkDir * 2.8, raycastParams)

    local hitFeet = (feetRay and feetRay.Instance and feetRay.Instance.CanCollide and feetRay.Instance.Name ~= DOOR_BLOCKER_NAME)
    local hitKnee = (kneeRay and kneeRay.Instance and kneeRay.Instance.CanCollide and kneeRay.Instance.Name ~= DOOR_BLOCKER_NAME)

    return hitFeet or hitKnee
end

local function forceWalkDirect(targetPos, reachDist, maxTimeout)
    reachDist = reachDist or 2.2
    maxTimeout = maxTimeout or 5
    local startT = tick()
    local lastPos = root.Position
    local lastStuckT = tick()

    setSprintState(true)

    while FarmConfig.Enabled and hum.Health > 0 and (tick() - startT) < maxTimeout do
        local curPos = root.Position
        local diff = targetPos - curPos
        local horizontal = Vector3.new(diff.X, 0, diff.Z)
        local dist = horizontal.Magnitude

        if dist <= reachDist then
            break
        end

        hum:Move(horizontal.Unit, false)
        local targetLook = CFrame.lookAt(curPos, curPos + horizontal)
        root.CFrame = root.CFrame:Lerp(targetLook, 0.3)

        if shouldJumpObstacle(horizontal) or (targetPos.Y - curPos.Y) > 0.8 then
            executePreciseJump()
        end

        if (curPos - lastPos).Magnitude < 0.25 then
            if (tick() - lastStuckT) > 0.4 then
                executePreciseJump()
                lastStuckT = tick()
            end
        else
            lastPos = curPos
            lastStuckT = tick()
        end

        task.wait(0.03)
    end
    setSprintState(false)
    hum:Move(Vector3.zero, false)
end

local function walkLongDistance(destinationPos, targetFloor, maxTime)
    if not root or not hum or hum.Health <= 0 then return false end
    maxTime = maxTime or 25
    local startTime = tick()

    local path = PathfindingService:CreatePath({
        AgentRadius = 1.7,
        AgentHeight = 4.8,
        AgentCanJump = true,
        AgentCanClimb = false,
        AgentMaxSlope = 65,
        WaypointSpacing = 3.5
    })

    local success, _ = pcall(function()
        path:ComputeAsync(root.Position, destinationPos)
    end)

    if not success or path.Status ~= Enum.PathStatus.Success then
        clearPathVisual()
        setSprintState(true)
        hum:MoveTo(destinationPos)
        return false
    end

    local rawWaypoints = path:GetWaypoints()

    local waypoints = {}
    for _, wp in ipairs(rawWaypoints) do
        if FarmConfig.SelectedJobLocation == "8-Eleven (Minimart)" and wp.Position.Z < 58.5 and math.abs(wp.Position.X - 173.47) < 7 then
            clearPathVisual()
            return false
        end
        table.insert(waypoints, wp)
    end

    renderPathVisual(waypoints)

    local currentWPIndex = 2
    local lastStuckCheckPos = root.Position
    local lastStuckTime = tick()
    local isFinished = false

    setSprintState(true)

    local heartbeatConn
    heartbeatConn = RunService.Heartbeat:Connect(function()
        if not FarmConfig.Enabled or hum.Health <= 0 or (tick() - startTime) > maxTime or currentWPIndex > #waypoints then
            isFinished = true
            return
        end

        local wp = waypoints[currentWPIndex]
        local isLast = (currentWPIndex == #waypoints)
        local currentPos = root.Position
        local targetVec = wp.Position - currentPos
        local horizontalVec = Vector3.new(targetVec.X, 0, targetVec.Z)
        local dist = horizontalVec.Magnitude

        if dist > 0.1 then
            hum:Move(horizontalVec.Unit, false)
            local targetLookCFrame = CFrame.lookAt(currentPos, currentPos + horizontalVec)
            root.CFrame = root.CFrame:Lerp(targetLookCFrame, 0.28)
        end

        if wp.Action == Enum.PathWaypointAction.Jump then
            executePreciseJump()
        end

        if (wp.Position.Y - currentPos.Y) > 1.25 then
            executePreciseJump()
        end

        if shouldJumpObstacle(horizontalVec) then
            executePreciseJump()
        end

        if (currentPos - lastStuckCheckPos).Magnitude < 0.25 and root.AssemblyLinearVelocity.Magnitude < 1.5 then
            if (tick() - lastStuckTime) > 0.45 then
                executePreciseJump()
                lastStuckTime = tick()
            end
        else
            lastStuckCheckPos = currentPos
            lastStuckTime = tick()
        end

        if not isLast then
            if dist <= 3.0 then
                currentWPIndex = currentWPIndex + 1
            end
        else
            if dist <= 2.2 and math.abs(currentPos.Y - wp.Position.Y) <= 3.5 then
                isFinished = true
            end
        end
    end)

    while not isFinished and FarmConfig.Enabled and hum.Health > 0 do
        task.wait(0.04)
    end

    if heartbeatConn then
        heartbeatConn:Disconnect()
    end

    setSprintState(false)
    hum:Move(Vector3.zero, false)
    clearPathVisual()
    return true
end

local function autoDecideCafeMess()
    local map = Workspace:FindFirstChild("Workspace_PackageLink")
        and Workspace.Workspace_PackageLink:FindFirstChild("Map")
        or Workspace:FindFirstChild("Map", true)

    if not map then return end

    local buildings = map:FindFirstChild("Buildings")
    local cafe = buildings and buildings:FindFirstChild("Mofumofu")
    local messFolder = cafe and cafe:FindFirstChild("Mess")

    if not messFolder then return end

    local myFloor = getAccurateFloorLevel(root.Position)
    local sameFloorTargets = {}
    local otherFloorTargets = {}

    for _, mess in ipairs(messFolder:GetChildren()) do
        local prompt = mess:FindFirstChildWhichIsA("ProximityPrompt", true)
        local part = mess:IsA("BasePart") and mess 
            or (mess:IsA("Model") and (mess.PrimaryPart or mess:FindFirstChildWhichIsA("BasePart", true)))

        if part and prompt and prompt.Enabled then
            local itemFloor = getAccurateFloorLevel(part.Position)
            local dist = (Vector2.new(root.Position.X, root.Position.Z) - Vector2.new(part.Position.X, part.Position.Z)).Magnitude

            local itemData = {
                Target = mess,
                Prompt = prompt,
                Part = part,
                Dist = dist,
                Floor = itemFloor
            }

            if itemFloor == myFloor then
                table.insert(sameFloorTargets, itemData)
            else
                table.insert(otherFloorTargets, itemData)
            end
        end
    end

    local targetList = #sameFloorTargets > 0 and sameFloorTargets or otherFloorTargets
    if #targetList == 0 then return end

    table.sort(targetList, function(a, b) return a.Dist < b.Dist end)

    local currentTask = targetList[1]
    local bestTarget = currentTask.Target
    local bestPrompt = currentTask.Prompt
    local bestPart = currentTask.Part
    local targetFloor = currentTask.Floor

    if myFloor ~= targetFloor then
        if targetFloor == 2 and myFloor == 1 then
            walkLongDistance(FLOOR_2_ENTRY_POS, 2, 18)
        elseif targetFloor == 1 and myFloor == 2 then
            walkLongDistance(FLOOR_1_ENTRY_POS, 1, 18)
        end
        task.wait(0.2)
    end

    walkLongDistance(bestPart.Position, targetFloor, 20)

    local waitStart = tick()
    local canPress = false

    while (tick() - waitStart) < 2.5 do
        if not FarmConfig.Enabled then break end

        local dist = (Vector2.new(root.Position.X, root.Position.Z) - Vector2.new(bestPart.Position.X, bestPart.Position.Z)).Magnitude
        local currentFloor = getAccurateFloorLevel(root.Position)

        if (currentFloor == targetFloor and dist <= 2.2) or isActionPromptVisibleOnScreen() then
            canPress = true
            break
        end

        local stepDir = (bestPart.Position - root.Position)
        hum:Move(Vector3.new(stepDir.X, 0, stepDir.Z).Unit, false)
        task.wait(0.05)
    end

    hum:Move(Vector3.zero, false)

    if canPress then
        task.wait(0.1)
        if fireproximityprompt then
            fireproximityprompt(bestPrompt)
        end
        local duration = (bestPrompt.HoldDuration > 0) and (bestPrompt.HoldDuration + 0.1) or FarmConfig.HoldDelay
        pressTKey(duration)
        task.wait(0.4)
    end
end

local function handle8Eleven()
    local pkgLink = Workspace:FindFirstChild("Workspace_PackageLink")
    if not pkgLink then return end

    local store = pkgLink:FindFirstChild("811Store")
    local rep = store and store:FindFirstChild("Replication")
    local b811 = rep and rep:FindFirstChild("811")
    if not b811 then return end

    local storeModel = b811:FindFirstChild("Model")
    local cleaningTargets = {}
    local myPos = root.Position

    local function evaluateTarget(item, itemType)
        local prompt = item:FindFirstChildWhichIsA("ProximityPrompt", true)
        local part = item:IsA("BasePart") and item 
            or (item:IsA("Model") and (item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart", true)))

        if part and prompt and prompt.Enabled then
            if part.Position.Z >= 58.5 then
                local dist = (Vector2.new(myPos.X, myPos.Z) - Vector2.new(part.Position.X, part.Position.Z)).Magnitude
                table.insert(cleaningTargets, {
                    Target = item,
                    Prompt = prompt,
                    Part = part,
                    Dist = dist,
                    Type = itemType
                })
            end
        end
    end

    if storeModel then
        for _, item in ipairs(storeModel:GetChildren()) do
            local name = item.Name
            if string.find(name, "^Litter") then
                evaluateTarget(item, "Litter")
            elseif string.find(name, "^RamenCup") then
                evaluateTarget(item, "RamenCup")
            end
        end
    end

    for _, item in ipairs(b811:GetChildren()) do
        if string.find(item.Name, "^WindowSmudge") then
            evaluateTarget(item, "WindowSmudge")
        end
    end

    if #cleaningTargets == 0 then return end

    table.sort(cleaningTargets, function(a, b) return a.Dist < b.Dist end)

    local currentTask = cleaningTargets[1]
    local bestTarget = currentTask.Target
    local bestPrompt = currentTask.Prompt
    local bestPart = currentTask.Part
    local targetPos = bestPart.Position

    local distToA = (Vector2.new(myPos.X, myPos.Z) - Vector2.new(STORE_PASS_POINT_A.X, STORE_PASS_POINT_A.Z)).Magnitude
    local distToB = (Vector2.new(myPos.X, myPos.Z) - Vector2.new(STORE_PASS_POINT_B.X, STORE_PASS_POINT_B.Z)).Magnitude
    local targetDistToA = (Vector2.new(targetPos.X, targetPos.Z) - Vector2.new(STORE_PASS_POINT_A.X, STORE_PASS_POINT_A.Z)).Magnitude
    local targetDistToB = (Vector2.new(targetPos.X, targetPos.Z) - Vector2.new(STORE_PASS_POINT_B.X, STORE_PASS_POINT_B.Z)).Magnitude

    if (distToA < distToB and targetDistToB < targetDistToA) then
        walkLongDistance(STORE_PASS_POINT_A, 1, 10)
        forceWalkDirect(STORE_PASS_POINT_B, 2.0, 4)
        task.wait(0.1)
    elseif (distToB < distToA and targetDistToA < targetDistToB) then
        walkLongDistance(STORE_PASS_POINT_B, 1, 10)
        forceWalkDirect(STORE_PASS_POINT_A, 2.0, 4)
        task.wait(0.1)
    end

    local isInsideTask = (targetPos.Z >= 95.0) or (targetPos.Y <= -11.5)
    local curDistToInnerAnchor = (Vector2.new(root.Position.X, root.Position.Z) - Vector2.new(STORE_INNER_ENTRY_POS.X, STORE_INNER_ENTRY_POS.Z)).Magnitude

    if isInsideTask and curDistToInnerAnchor > 3.0 then
        walkLongDistance(STORE_INNER_ENTRY_POS, 1, 12)
        task.wait(0.1)
    end

    walkLongDistance(bestPart.Position, 1, 20)

    local waitStart = tick()
    local canPress = false

    while (tick() - waitStart) < 2.5 do
        if not FarmConfig.Enabled then break end

        local dist = (Vector2.new(root.Position.X, root.Position.Z) - Vector2.new(bestPart.Position.X, bestPart.Position.Z)).Magnitude
        if dist <= 2.2 or isActionPromptVisibleOnScreen() then
            canPress = true
            break
        end

        local stepDir = (bestPart.Position - root.Position)
        hum:Move(Vector3.new(stepDir.X, 0, stepDir.Z).Unit, false)
        task.wait(0.05)
    end

    hum:Move(Vector3.zero, false)

    if canPress then
        task.wait(0.1)
        if fireproximityprompt then
            fireproximityprompt(bestPrompt)
        end
        local duration = (bestPrompt.HoldDuration > 0) and (bestPrompt.HoldDuration + 0.1) or FarmConfig.HoldDelay
        pressTKey(duration)
        task.wait(0.4)
    end
end

local function handleAutoRepair()
    local stainsFolder = Workspace:FindFirstChild("ChirinStains")
    if not stainsFolder then return end

    local stainTasks = {}
    local myPos = root.Position

    for _, stain in ipairs(stainsFolder:GetChildren()) do
        local prompt = stain:FindFirstChildWhichIsA("ProximityPrompt", true)
        local part = stain:IsA("BasePart") and stain 
            or (stain:IsA("Model") and (stain.PrimaryPart or stain:FindFirstChildWhichIsA("BasePart", true)))

        if part and prompt and prompt.Enabled then
            local dist = (Vector2.new(myPos.X, myPos.Z) - Vector2.new(part.Position.X, part.Position.Z)).Magnitude
            table.insert(stainTasks, {
                Target = stain,
                Prompt = prompt,
                Part = part,
                Dist = dist
            })
        end
    end

    if #stainTasks == 0 then return end

    table.sort(stainTasks, function(a, b) return a.Dist < b.Dist end)

    local currentTask = stainTasks[1]
    local bestTarget = currentTask.Target
    local bestPrompt = currentTask.Prompt
    local bestPart = currentTask.Part

    walkLongDistance(bestPart.Position, 1, 20)

    local waitStart = tick()
    local canPress = false

    while (tick() - waitStart) < 2.5 do
        if not FarmConfig.Enabled then break end

        local dist = (Vector2.new(root.Position.X, root.Position.Z) - Vector2.new(bestPart.Position.X, bestPart.Position.Z)).Magnitude
        if dist <= 2.2 or isActionPromptVisibleOnScreen() then
            canPress = true
            break
        end

        local stepDir = (bestPart.Position - root.Position)
        hum:Move(Vector3.new(stepDir.X, 0, stepDir.Z).Unit, false)
        task.wait(0.05)
    end

    hum:Move(Vector3.zero, false)

    if canPress then
        task.wait(0.1)
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.T, false, game)
        if fireproximityprompt then
            fireproximityprompt(bestPrompt)
        end

        local cleanStart = tick()
        local maxCleanTime = 5.0

        while FarmConfig.Enabled and bestTarget.Parent == stainsFolder and (tick() - cleanStart) < maxCleanTime do
            if fireproximityprompt then
                fireproximityprompt(bestPrompt)
            end
            task.wait(0.1)
        end

        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.T, false, game)
        task.wait(0.3)
    end
end

