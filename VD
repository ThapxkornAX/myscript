local cleanupData = {
    Connections = {},
    Threads = {},
    OriginalHook = nil,
    OldNamecall = nil,
    ESPObjects = {},
    GenESPObjects = {}
}

local function cleanup()
    for _, th in ipairs(cleanupData.Threads) do
        if th and coroutine.status(th) ~= "dead" then
            task.cancel(th)
        end
    end
    table.clear(cleanupData.Threads)

    for _, conn in ipairs(cleanupData.Connections) do
        if conn and typeof(conn) == "RBXScriptConnection" and conn.Connected then
            conn:Disconnect()
        end
    end
    table.clear(cleanupData.Connections)

    for _, obj in ipairs(cleanupData.ESPObjects) do
        if obj and obj.Parent then
            obj:Destroy()
        end
    end
    table.clear(cleanupData.ESPObjects)

    for _, obj in ipairs(cleanupData.GenESPObjects) do
        if obj and obj.Parent then
            obj:Destroy()
        end
    end
    table.clear(cleanupData.GenESPObjects)

    if cleanupData.OriginalHook and cleanupData.OldNamecall then
        pcall(function()
            hookmetamethod(game, "__namecall", cleanupData.OldNamecall)
        end)
    end

    local character = game:GetService("Players").LocalPlayer.Character
    if character and character:FindFirstChildOfClass("Humanoid") then
        character:FindFirstChildOfClass("Humanoid").PlatformStand = false
    end

    print("[Auto-Gen] ล้างระบบเก่าเรียบร้อย")
end

if getgenv then
    getgenv().AutoRepairCleanup = cleanup
end

