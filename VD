local genEspThread = task.spawn(function()
    while true do
        task.wait(0.15)
        local myChar = LocalPlayer.Character
        local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
        local amIKiller = isKiller(LocalPlayer)

        local canShowGen = isGenESPEnabled and not amIKiller

        for genModel, data in pairs(genTracks) do
            if data.Model and data.Model.Parent and data.Part and data.Highlight and data.Label then
                local isCompleted = data.Model:GetAttribute("Completed") == true
                local progress = data.Model:GetAttribute("RepairProgress") or 0

                if isCompleted or progress >= 100 then
                    data.Highlight.Enabled = false
                    data.Billboard.Enabled = false
                elseif canShowGen and myHrp then
                    data.Highlight.Enabled = true
                    data.Billboard.Enabled = true

                    local distance = math.floor((data.Part.Position - myHrp.Position).Magnitude)
                    data.Label.Text = string.format("⚡ Generator (%d%%)\n[%dm]", math.floor(progress), distance)
                else
                    data.Highlight.Enabled = false
                    data.Billboard.Enabled = false
                end
            else
                genTracks[genModel] = nil
            end
        end
    end
end)
table.insert(cleanupData.Threads, genEspThread)

