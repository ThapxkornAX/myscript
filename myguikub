function Library:AddTab(tabName, iconText)
    local TabData = {}
    
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 42, 0, 42)
    btn.BackgroundColor3 = BG_DARK
    btn.Text = iconText or "📌"
    btn.TextColor3 = Color3.fromRGB(0, 150, 255)
    btn.TextSize = 18
    btn.Parent = IconGroup
    addCorner(btn, 12)
    local stroke = addGlowBorder(btn, Color3.fromRGB(80, 80, 80), 1, 0.5)

    local sf = Instance.new("ScrollingFrame")
    sf.Name = tabName .. "Content"
    sf.Size = UDim2.new(1, -20, 1, -45)
    sf.Position = UDim2.new(0, 10, 0, 38)
    sf.BackgroundTransparency = 1
    sf.BorderSizePixel = 0
    sf.ScrollBarThickness = 3
    sf.ScrollBarImageColor3 = MINT_NEON
    sf.Visible = false
    sf.Parent = MainFrame

    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 8)
    layout.Parent = sf

    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        sf.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 10)
    end)

    TabData.Button = btn
    TabData.Stroke = stroke
    TabData.Container = sf
    TabData.Name = tabName

    table.insert(Tabs, TabData)

    btn.MouseButton1Click:Connect(function()
        for _, t in ipairs(Tabs) do
            t.Container.Visible = (t == TabData)
            t.Stroke.Color = (t == TabData) and MINT_NEON or Color3.fromRGB(80, 80, 80)
            t.Stroke.Thickness = (t == TabData) and 1.5 or 1
        end
        MainTitle.Text = tabName
    end)

    if FirstTab then
        FirstTab = false
        sf.Visible = true
        stroke.Color = MINT_NEON
        stroke.Thickness = 1.5
        MainTitle.Text = tabName
    end

