            function Section:AddKeybind(bindName, defaultKey, callback)
                local BindFrame = Instance.new("Frame")
                BindFrame.Size = UDim2.new(1, 0, 0, 32)
                BindFrame.BackgroundTransparency = 1
                BindFrame.Parent = SectionFrame
                
                local Title = Instance.new("TextLabel", BindFrame)
                Title.Size = UDim2.new(0.7, 0, 1, 0)
                Title.BackgroundTransparency = 1
                Title.Text = bindName
                Title.TextColor3 = Theme.Text
                Title.TextXAlignment = Enum.TextXAlignment.Left
                Title.Font = Enum.Font.GothamBold
                Title.TextSize = 11
                
                local BindBtn = Instance.new("TextButton", BindFrame)
                BindBtn.Size = UDim2.new(0.3, 0, 0, 26)
                BindBtn.Position = UDim2.new(0.7, 0, 0.5, -13)
                BindBtn.BackgroundColor3 = Theme.ElementBg
                BindBtn.Text = defaultKey.Name
                BindBtn.TextColor3 = Theme.Accent
                BindBtn.Font = Enum.Font.GothamBold
                BindBtn.TextSize = 10
                Instance.new("UICorner", BindBtn).CornerRadius = UDim.new(0, 4)
                Instance.new("UIStroke", BindBtn).Color = Theme.Border
                
                local currentKey = defaultKey
                local isListening = false
                
                BindBtn.MouseButton1Click:Connect(function()
                    BindBtn.Text = "..."
                    isListening = true
                end)
                
                UserInputService.InputBegan:Connect(function(input)
                    if isListening and input.UserInputType == Enum.UserInputType.Keyboard then
                        currentKey = input.KeyCode
                        BindBtn.Text = currentKey.Name
                        isListening = false
                        if callback then callback(currentKey, true) end 
                    elseif not isListening and input.KeyCode == currentKey then
                        if callback then callback(currentKey, false) end
                    end
                end)
            end

            return Section
        end
        return Tab
    end
    return Window
end

return Library
