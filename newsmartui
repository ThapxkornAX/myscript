local Library = {}
local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Theme = {
    MainBg = Color3.fromRGB(25, 25, 25),
    SectionBg = Color3.fromRGB(35, 35, 35),
    ElementBg = Color3.fromRGB(45, 45, 45),
    HoverBg = Color3.fromRGB(55, 55, 55),
    Border = Color3.fromRGB(60, 60, 60),
    Accent = Color3.fromRGB(124, 58, 237),
    Text = Color3.fromRGB(255, 255, 255),
    DimText = Color3.fromRGB(170, 170, 170)
}

local function Tween(instance, properties, duration, style, dir)
    local tweenInfo = TweenInfo.new(
        duration or 0.2, 
        style or Enum.EasingStyle.Quad, 
        dir or Enum.EasingDirection.Out
    )
    local tween = TweenService:Create(instance, tweenInfo, properties)
    tween:Play()
    return tween
end

function Library:MakeWindow(config)
    local config = config or {}
    local WindowName = config.Name or "Porry's Script"
    local WindowIcon = config.Icon or "" 
    
    if CoreGui:FindFirstChild("CustomPorryUI") then
        CoreGui.CustomPorryUI:Destroy()
    end
    
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "CustomPorryUI"
    ScreenGui.Parent = CoreGui
    ScreenGui.ResetOnSpawn = false
    
    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    -- ปรับขนาดให้เป็นแนวตั้งและพอดีกับ 2 คอลัมน์ตามรูป
    MainFrame.Size = UDim2.new(0, 500, 0, 620)
    MainFrame.AnchorPoint = Vector2.new(0.5, 0.5) 
    MainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
    MainFrame.BackgroundColor3 = Theme.MainBg
    MainFrame.BackgroundTransparency = 0.05 -- โปร่งแสงนิดๆ ให้ดูมีมิติ
    MainFrame.BorderSizePixel = 0
    MainFrame.Active = true
    MainFrame.Draggable = true
    MainFrame.Parent = ScreenGui
    Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 8)
    
    local UIScale = Instance.new("UIScale")
    UIScale.Parent = MainFrame
    UIScale.Scale = 1 -- เริ่มต้นที่ 1 (แสดงผล 100%)
    
    Instance.new("UIStroke", MainFrame).Color = Theme.Border
    
    local ProfileIcon = Instance.new("ImageLabel")
    ProfileIcon.Size = UDim2.new(0, 26, 0, 26)
    ProfileIcon.Position = UDim2.new(0, 12, 0, 8)
    ProfileIcon.BackgroundTransparency = 1
    ProfileIcon.Image = WindowIcon
    ProfileIcon.ScaleType = Enum.ScaleType.Crop
    Instance.new("UICorner", ProfileIcon).CornerRadius = UDim.new(1, 0)
    ProfileIcon.Parent = MainFrame
    
    local TitleLabel = Instance.new("TextLabel")
    TitleLabel.Size = UDim2.new(1, -55, 0, 42)
    TitleLabel.Position = UDim2.new(0, 48, 0, 0)
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Text = WindowName
    TitleLabel.TextColor3 = Theme.Text
    TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
    TitleLabel.Font = Enum.Font.GothamBold
    TitleLabel.TextSize = 13
    TitleLabel.Parent = MainFrame
    
    local Line = Instance.new("Frame", MainFrame)
    Line.Size = UDim2.new(1, 0, 0, 1)
    Line.Position = UDim2.new(0, 0, 0, 42)
    Line.BackgroundColor3 = Theme.Border
    Line.BorderSizePixel = 0
    
    local TabContainer = Instance.new("Frame")
    TabContainer.Size = UDim2.new(1, -20, 0, 36)
    TabContainer.Position = UDim2.new(0, 10, 0, 43)
    TabContainer.BackgroundTransparency = 1
    TabContainer.Parent = MainFrame
    
    local TabListLayout = Instance.new("UIListLayout", TabContainer)
    TabListLayout.FillDirection = Enum.FillDirection.Horizontal
    TabListLayout.SortOrder = Enum.SortOrder.LayoutOrder
    TabListLayout.Padding = UDim.new(0, 5)
    
    local ContentContainer = Instance.new("Frame")
    ContentContainer.Size = UDim2.new(1, -20, 1, -95)
    ContentContainer.Position = UDim2.new(0, 10, 0, 85)
    ContentContainer.BackgroundTransparency = 1
    ContentContainer.Parent = MainFrame

    local Window = {}
    Window.HideKey = config.HideKey or Enum.KeyCode.RightControl
    local FirstTab = true

    local isOpen = true
    local isAnimating = false

    local function ToggleUI(state)
        if isAnimating then return end
        isAnimating = true
        
        if state then
            -- เปิด (เด้งจาก 0 ไป 1)
            MainFrame.Visible = true
            UIScale.Scale = 0
            local tween = Tween(UIScale, {Scale = 1}, 0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            tween.Completed:Connect(function() isAnimating = false end)
        else
            -- ปิด (หดจาก 1 กลับไป 0)
            local tween = Tween(UIScale, {Scale = 0}, 0.25, Enum.EasingStyle.Back, Enum.EasingDirection.In)
            tween.Completed:Connect(function()
                MainFrame.Visible = false
                isAnimating = false
            end)
        end
        isOpen = state
    end

    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if not gameProcessed and input.KeyCode == Window.HideKey then
            ToggleUI(not isOpen)
        end
    end)

    function Window:MakeTab(tabName)
        local TabBtn = Instance.new("TextButton")
        TabBtn.Size = UDim2.new(0, 95, 1, 0)
        TabBtn.BackgroundTransparency = 1
        TabBtn.Text = tabName
        TabBtn.TextColor3 = FirstTab and Theme.Accent or Theme.DimText
        TabBtn.Font = Enum.Font.GothamBold
        TabBtn.TextSize = 12
        TabBtn.Parent = TabContainer
        
        local TabIndicator = Instance.new("Frame", TabBtn)
        TabIndicator.Size = UDim2.new(1, 0, 0, 2)
        TabIndicator.Position = UDim2.new(0, 0, 1, -2)
        TabIndicator.BackgroundColor3 = Theme.Accent
        TabIndicator.BorderSizePixel = 0
        TabIndicator.Visible = FirstTab
        
        local TabPage = Instance.new("Frame")
        TabPage.Size = UDim2.new(1, 0, 1, 0)
        TabPage.BackgroundTransparency = 1
        TabPage.Visible = FirstTab
        TabPage.Parent = ContentContainer
        
        local LeftCol = Instance.new("ScrollingFrame")
        LeftCol.Size = UDim2.new(0.49, 0, 1, 0)
        LeftCol.BackgroundTransparency = 1
        LeftCol.ScrollBarThickness = 2
        LeftCol.ScrollBarImageColor3 = Theme.Accent
        LeftCol.Parent = TabPage
        local LeftLayout = Instance.new("UIListLayout", LeftCol)
        LeftLayout.Padding = UDim.new(0, 8)
        
        local RightCol = Instance.new("ScrollingFrame")
        RightCol.Size = UDim2.new(0.49, 0, 1, 0)
        RightCol.Position = UDim2.new(0.51, 0, 0, 0)
        RightCol.BackgroundTransparency = 1
        RightCol.ScrollBarThickness = 2
        RightCol.ScrollBarImageColor3 = Theme.Accent
        RightCol.Parent = TabPage
        local RightLayout = Instance.new("UIListLayout", RightCol)
        RightLayout.Padding = UDim.new(0, 8)

        TabBtn.MouseButton1Click:Connect(function()
            for _, child in pairs(ContentContainer:GetChildren()) do
                if child:IsA("Frame") then child.Visible = false end
            end
            for _, btn in pairs(TabContainer:GetChildren()) do
                if btn:IsA("TextButton") then 
                    btn.TextColor3 = Theme.DimText 
                    btn.Frame.Visible = false
                end
            end
            TabPage.Visible = true
            TabBtn.TextColor3 = Theme.Accent
            TabIndicator.Visible = true
        end)
        
        FirstTab = false

        local Tab = {}
        
        function Tab:AddSection(sectionName, side)
            local targetCol = (side == "Right") and RightCol or LeftCol
            
            local SectionFrame = Instance.new("Frame")
            SectionFrame.Size = UDim2.new(1, -5, 0, 30)
            SectionFrame.BackgroundColor3 = Theme.SectionBg
            SectionFrame.Parent = targetCol
            Instance.new("UICorner", SectionFrame).CornerRadius = UDim.new(0, 6)
            
            Instance.new("UIStroke", SectionFrame).Color = Theme.Border
            
            local SecPadding = Instance.new("UIPadding", SectionFrame)
            SecPadding.PaddingTop = UDim.new(0, 6)
            SecPadding.PaddingBottom = UDim.new(0, 6)
            SecPadding.PaddingLeft = UDim.new(0, 8)
            SecPadding.PaddingRight = UDim.new(0, 8)
            
            local SectionLayout = Instance.new("UIListLayout", SectionFrame)
            SectionLayout.Padding = UDim.new(0, 6)
            
            local SectionTitle = Instance.new("TextLabel")
            SectionTitle.Size = UDim2.new(1, 0, 0, 18)
            SectionTitle.BackgroundTransparency = 1
            SectionTitle.Text = sectionName
            SectionTitle.TextColor3 = Theme.Text
            SectionTitle.TextXAlignment = Enum.TextXAlignment.Left
            SectionTitle.Font = Enum.Font.GothamBold
            SectionTitle.TextSize = 12
            SectionTitle.Parent = SectionFrame
            
            local LineSep = Instance.new("Frame", SectionFrame)
            LineSep.Size = UDim2.new(1, 0, 0, 1)
            LineSep.BackgroundColor3 = Theme.Border
            LineSep.BorderSizePixel = 0
            
            SectionLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                SectionFrame.Size = UDim2.new(1, -5, 0, SectionLayout.AbsoluteContentSize.Y + 12)
                targetCol.CanvasSize = UDim2.new(0, 0, 0, targetCol.UIListLayout.AbsoluteContentSize.Y + 12)
            end)

            local Section = {}
            
            function Section:AddButton(btnName, callback)
                local Btn = Instance.new("TextButton")
                Btn.Size = UDim2.new(1, 0, 0, 30)
                Btn.BackgroundColor3 = Theme.Accent
                Btn.Text = btnName
                Btn.TextColor3 = Theme.Text
                Btn.Font = Enum.Font.GothamBold
                Btn.TextSize = 12
                Btn.AutoButtonColor = false
                Btn.Parent = SectionFrame
                Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 4)
                
                Btn.MouseEnter:Connect(function() Tween(Btn, {BackgroundColor3 = Color3.fromRGB(Theme.Accent.R*255 + 20, Theme.Accent.G*255 + 20, Theme.Accent.B*255 + 20)}) end)
                Btn.MouseLeave:Connect(function() Tween(Btn, {BackgroundColor3 = Theme.Accent}) end)
                Btn.MouseButton1Click:Connect(function() if callback then callback() end end)
            end

            -- ปรับ Toggle ให้เป็นกล่องเช็คถูก (Checkbox) ตามในภาพ
            function Section:AddToggle(toggleName, default, callback)
                local state = default or false
                local ToggleFrame = Instance.new("TextButton")
                ToggleFrame.Size = UDim2.new(1, 0, 0, 26)
                ToggleFrame.BackgroundTransparency = 1
                ToggleFrame.Text = ""
                ToggleFrame.Parent = SectionFrame
                
                local Title = Instance.new("TextLabel")
                Title.Size = UDim2.new(1, -30, 1, 0)
                Title.BackgroundTransparency = 1
                Title.Text = toggleName
                Title.TextColor3 = Theme.DimText
                Title.TextXAlignment = Enum.TextXAlignment.Left
                Title.Font = Enum.Font.GothamBold
                Title.TextSize = 11
                Title.Parent = ToggleFrame
                
                local Box = Instance.new("Frame")
                Box.Size = UDim2.new(0, 18, 0, 18)
                Box.Position = UDim2.new(1, -18, 0.5, -9)
                Box.BackgroundColor3 = Theme.ElementBg
                Box.Parent = ToggleFrame
                Instance.new("UICorner", Box).CornerRadius = UDim.new(0, 4)
                Instance.new("UIStroke", Box).Color = Theme.Border
                
                local CheckMark = Instance.new("TextLabel", Box)
                CheckMark.Size = UDim2.new(1, 0, 1, 0)
                CheckMark.BackgroundTransparency = 1
                CheckMark.Text = "✔"
                CheckMark.TextColor3 = Theme.Text
                CheckMark.TextSize = 12
                CheckMark.TextTransparency = state and 0 or 1
                
                ToggleFrame.MouseButton1Click:Connect(function()
                    state = not state
                    Tween(CheckMark, {TextTransparency = state and 0 or 1}, 0.15)
                    Tween(Box, {BackgroundColor3 = state and Theme.Accent or Theme.ElementBg}, 0.15)
                    if callback then callback(state) end
                end)
            end

            function Section:AddDropdown(dropName, options, default, callback)
                local DropdownFrame = Instance.new("Frame")
                DropdownFrame.Size = UDim2.new(1, 0, 0, 32)
                DropdownFrame.BackgroundColor3 = Theme.ElementBg
                DropdownFrame.ClipsDescendants = true
                DropdownFrame.Parent = SectionFrame
                Instance.new("UICorner", DropdownFrame).CornerRadius = UDim.new(0, 4)
                Instance.new("UIStroke", DropdownFrame).Color = Theme.Border
                
                local DropBtn = Instance.new("TextButton", DropdownFrame)
                DropBtn.Size = UDim2.new(1, 0, 0, 32)
                DropBtn.BackgroundTransparency = 1
                DropBtn.Text = "  " .. dropName .. " : " .. default
                DropBtn.TextColor3 = Theme.Text
                DropBtn.TextXAlignment = Enum.TextXAlignment.Left
                DropBtn.Font = Enum.Font.GothamBold
                DropBtn.TextSize = 11
                
                local Icon = Instance.new("TextLabel", DropBtn)
                Icon.Size = UDim2.new(0, 20, 0, 20)
                Icon.Position = UDim2.new(1, -25, 0.5, -10)
                Icon.BackgroundTransparency = 1
                Icon.Text = "▼"
                Icon.TextColor3 = Theme.DimText
                Icon.Font = Enum.Font.Gotham
                Icon.TextSize = 11
                
                local OptionContainer = Instance.new("Frame", DropdownFrame)
                OptionContainer.Size = UDim2.new(1, 0, 0, 0)
                OptionContainer.Position = UDim2.new(0, 0, 0, 32)
                OptionContainer.BackgroundTransparency = 1
                local OptLayout = Instance.new("UIListLayout", OptionContainer)
                
                local opened = false
                DropBtn.MouseButton1Click:Connect(function()
                    opened = not opened
                    local targetSize = opened and (OptLayout.AbsoluteContentSize.Y + 36) or 32
                    Tween(DropdownFrame, {Size = UDim2.new(1, 0, 0, targetSize)})
                    Icon.Text = opened and "▲" or "▼"
                end)
                
                for _, opt in ipairs(options) do
                    local OptBtn = Instance.new("TextButton", OptionContainer)
                    OptBtn.Size = UDim2.new(1, -10, 0, 26)
                    OptBtn.Position = UDim2.new(0, 5, 0, 0)
                    OptBtn.BackgroundColor3 = Theme.SectionBg
                    OptBtn.Text = opt
                    OptBtn.TextColor3 = Theme.DimText
                    OptBtn.Font = Enum.Font.GothamBold
                    OptBtn.TextSize = 10
                    OptBtn.AutoButtonColor = false
                    Instance.new("UICorner", OptBtn).CornerRadius = UDim.new(0, 4)
                    
                    OptBtn.MouseEnter:Connect(function() Tween(OptBtn, {BackgroundColor3 = Theme.HoverBg, TextColor3 = Theme.Text}) end)
                    OptBtn.MouseLeave:Connect(function() Tween(OptBtn, {BackgroundColor3 = Theme.SectionBg, TextColor3 = Theme.DimText}) end)
                    
                    OptBtn.MouseButton1Click:Connect(function()
                        DropBtn.Text = "  " .. dropName .. " : " .. opt
                        opened = false
                        Tween(DropdownFrame, {Size = UDim2.new(1, 0, 0, 32)})
                        Icon.Text = "▼"
                        if callback then callback(opt) end
                    end)
                end
            end
            
            function Section:AddLabel(labelText)
                local Lbl = Instance.new("TextLabel")
                Lbl.Size = UDim2.new(1, 0, 0, 20)
                Lbl.BackgroundTransparency = 1
                Lbl.Text = labelText
                Lbl.TextColor3 = Theme.Accent
                Lbl.TextXAlignment = Enum.TextXAlignment.Left
                Lbl.Font = Enum.Font.GothamBold
                Lbl.TextSize = 11
                Lbl.Parent = SectionFrame
                return Lbl
            end

            function Section:AddTextbox(boxName, default, callback)
                local BoxFrame = Instance.new("Frame")
                BoxFrame.Size = UDim2.new(1, 0, 0, 32)
                BoxFrame.BackgroundTransparency = 1
                BoxFrame.Parent = SectionFrame
                
                local Title = Instance.new("TextLabel", BoxFrame)
                Title.Size = UDim2.new(0.6, 0, 1, 0)
                Title.BackgroundTransparency = 1
                Title.Text = boxName
                Title.TextColor3 = Theme.DimText
                Title.TextXAlignment = Enum.TextXAlignment.Left
                Title.Font = Enum.Font.GothamBold
                Title.TextSize = 11
                
                local TextBox = Instance.new("TextBox", BoxFrame)
                TextBox.Size = UDim2.new(0.4, 0, 0, 26)
                TextBox.Position = UDim2.new(0.6, 0, 0.5, -13)
                TextBox.BackgroundColor3 = Theme.ElementBg
                TextBox.Text = default or ""
                TextBox.TextColor3 = Theme.Text
                TextBox.Font = Enum.Font.Gotham
                TextBox.TextSize = 11
                Instance.new("UICorner", TextBox).CornerRadius = UDim.new(0, 4)
                Instance.new("UIStroke", TextBox).Color = Theme.Border
                
                TextBox.FocusLost:Connect(function()
                    if callback then callback(TextBox.Text) end
                end)
            end

            return Section
        end
        return Tab
    end
    return Window
end

return Library
