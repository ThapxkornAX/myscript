                    OptBtn.TextSize = 10
                    OptBtn.AutoButtonColor = false
                    Instance.new("UICorner", OptBtn).CornerRadius = UDim.new(0, 4)
                    
                    OptBtn.MouseButton1Click:Connect(function()
                        selected[opt] = not selected[opt]
                        -- เปลี่ยนสีตัวอักษรเป็นสีส้ม (Theme.Accent) เมื่อถูกเลือก
                        Tween(OptBtn, {TextColor3 = selected[opt] and Theme.Accent or Theme.DimText})
                        updateTitle()
                    end)
